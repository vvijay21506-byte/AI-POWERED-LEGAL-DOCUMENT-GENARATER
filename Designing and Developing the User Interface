3. DocumentForm.jsx
import { useState } from "react";

function DocumentForm({ onGenerate, loading }) {
  const [formData, setFormData] = useState({
    document_type: "",
    jurisdiction: "",
    parties: "",
    requirements: "",
  });

  const handleChange = (event) => {
    const { name, value } = event.target;

    setFormData((previous) => ({
      ...previous,
      [name]: value,
    }));
  };

  const handleSubmit = (event) => {
    event.preventDefault();

    onGenerate({
      ...formData,
      parties: formData.parties
        .split(",")
        .map((party) => party.trim())
        .filter(Boolean),
    });
  };

  return (
    <form className="document-form" onSubmit={handleSubmit}>
      <h2>Generate Legal Document</h2>

      <label>
        Document Type
        <select
          name="document_type"
          value={formData.document_type}
          onChange={handleChange}
          required
        >
          <option value="">Select document type</option>
          <option value="Rental Agreement">Rental Agreement</option>
          <option value="Employment Agreement">
            Employment Agreement
          </option>
          <option value="Non-Disclosure Agreement">
            Non-Disclosure Agreement
          </option>
          <option value="Legal Notice">Legal Notice</option>
          <option value="Affidavit">Affidavit</option>
          <option value="Other">Other</option>
        </select>
      </label>

      <label>
        Jurisdiction
        <input
          type="text"
          name="jurisdiction"
          placeholder="e.g. Tamil Nadu, India"
          value={formData.jurisdiction}
          onChange={handleChange}
          required
        />
      </label>

      <label>
        Parties
        <input
          type="text"
          name="parties"
          placeholder="e.g. John Doe, Jane Doe"
          value={formData.parties}
          onChange={handleChange}
        />
      </label>

      <label>
        Requirements
        <textarea
          name="requirements"
          rows="7"
          placeholder="Describe the requirements of your legal document..."
          value={formData.requirements}
          onChange={handleChange}
          required
        />
      </label>

      <button type="submit" disabled={loading}>
        {loading ? "Generating..." : "Generate Document"}
      </button>
    </form>
  );
}

export default DocumentForm;

4. API Integration — documentApi.js
const API_URL = "http://localhost:8000";

export async function generateDocument(documentData) {
  const response = await fetch(`${API_URL}/documents/generate`, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
    },
    body: JSON.stringify(documentData),
  });

  if (!response.ok) {
    const error = await response.json().catch(() => ({}));

    throw new Error(
      error.detail || "Unable to generate the legal document."
    );
  }

  return response.json();
}

5. GenerateDocument.jsx
import { useState } from "react";
import DocumentForm from "../components/DocumentForm";
import DocumentPreview from "../components/DocumentPreview";
import { generateDocument } from "../services/documentApi";

function GenerateDocument() {
  const [document, setDocument] = useState(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");

  const handleGenerate = async (data) => {
    setLoading(true);
    setError("");
    setDocument(null);

    try {
      const result = await generateDocument(data);
      setDocument(result);
    } catch (err) {
      setError(err.message);
    } finally {
      setLoading(false);
    }
  };

  return (
    <main className="generate-page">
      <DocumentForm
        onGenerate={handleGenerate}
        loading={loading}
      />

      {error && (
        <div className="error-message">
          {error}
        </div>
      )}

      {document && (
        <DocumentPreview document={document} />
      )}
    </main>
  );
}

export default GenerateDocument;

6. DocumentPreview.jsx
function DocumentPreview({ document }) {
  const handleCopy = async () => {
    await navigator.clipboard.writeText(document.content);
    alert("Document copied to clipboard.");
  };

  const handleDownload = () => {
    const blob = new Blob(
      [document.content],
      { type: "text/plain" }
    );

    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");

    link.href = url;
    link.download = `${document.document_type}.txt`;
    link.click();

    URL.revokeObjectURL(url);
  };

  return (
    <section className="document-preview">
      <div className="preview-header">
        <div>
          <h2>{document.document_type}</h2>
          <p>{document.jurisdiction}</p>
        </div>

        <div className="preview-actions">
          <button onClick={handleCopy}>
            Copy
          </button>

          <button onClick={handleDownload}>
            Download
          </button>
        </div>
      </div>

      <article className="document-content">
        {document.content}
      </article>
    </section>
  );
}

export default DocumentPreview;

