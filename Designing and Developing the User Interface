* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #f4f7fb;
  color: #1f2937;
}

.generate-page {
  width: min(1100px, 92%);
  margin: 40px auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30px;
}

.document-form,
.document-preview {
  background: white;
  padding: 28px;
  border-radius: 12px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
}

.document-form h2,
.document-preview h2 {
  margin-top: 0;
}

.document-form label {
  display: block;
  margin-top: 18px;
  font-weight: 600;
}

.document-form input,
.document-form select,
.document-form textarea {
  width: 100%;
  margin-top: 8px;
  padding: 12px;
  border: 1px solid #d1d5db;
  border-radius: 8px;
  font-size: 15px;
}

.document-form textarea {
  resize: vertical;
}

.document-form button,
.preview-actions button {
  border: none;
  border-radius: 8px;
  padding: 12px 18px;
  margin-top: 20px;
  cursor: pointer;
  background: #1d4ed8;
  color: white;
  font-weight: 600;
}

.document-form button {
  width: 100%;
}

.document-form button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.document-preview {
  min-height: 500px;
}

.preview-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 15px;
}

.preview-header p {
  color: #6b7280;
}

.preview-actions {
  display: flex;
  gap: 8px;
}

.preview-actions button {
  margin-top: 0;
}

.document-content {
  margin-top: 25px;
  padding: 25px;
  min-height: 400px;
  background: #fafafa;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  white-space: pre-wrap;
  line-height: 1.7;
}

.error-message {
  grid-column: 1 / -1;
  padding: 15px;
  border-radius: 8px;
  color: #991b1b;
  background: #fee2e2;
}

@media (max-width: 800px) {
  .generate-page {
    grid-template-columns: 1fr;
  }

  .preview-header {
    flex-direction: column;
  }
}

